# DoubleLamp server configuration (docs/05-server.md §12). Copy to server/.env; it is loaded at startup.
# Variables already set in the environment take precedence over this file.

# Public URL of the server: origin checks, the ws_url given to lamps at pairing, OTA download links.
# Production: https://lamps.<your-domain> (behind Cloudflare Tunnel). Default: http://localhost:$PORT
PUBLIC_URL=http://localhost:8080

# Development only: allows an http:// PUBLIC_URL that isn't localhost and drops the cookie Secure flag.
# Needed for "local dev on one WiFi", e.g. PUBLIC_URL=http://192.168.1.20:8080. Never in production.
#DEV_INSECURE=1

PORT=8080
HOST=0.0.0.0

# SQLite database, firmware files and the generated secret. Relative paths are relative to server/.
DATA_DIR=./data

# Shared password, used on first start only (12+ characters). If unset, one is generated and printed once.
# Remove it from the environment after the first start (07 §5).
#APP_PASSWORD=

# HMAC key for firmware download links and cookie signing (32+ random bytes). If unset, one is generated
# and kept in DATA_DIR/secret. Rotating it logs everyone out and expires download links.
#SERVER_SECRET=

# "cloudflare": take the client IP for rate limits from CF-Connecting-IP. Only safe when nothing but
# cloudflared can reach the port. "false" for local development.
TRUST_PROXY=false

# More allowed browser origins, comma-separated, e.g. the Vite dev server: http://localhost:5173
#EXTRA_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Docker Compose: the Cloudflare Tunnel token is NOT read from this file. Put TUNNEL_TOKEN=... in a .env file
# next to docker-compose.yml (compose substitutes ${TUNNEL_TOKEN}), or export it in the shell.
